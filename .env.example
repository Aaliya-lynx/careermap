# Copy this file to backend/.env and fill in your own values. Never commit .env.

# Models are tried in this order; if one fails or is rate limited, the next one answers.
# Format: provider=model. Each provider needs its own <PROVIDER>_BASE_URL and <PROVIDER>_API_KEY.
# For Azure the model name is your deployment name.
LLM_CHAIN=azure=gpt-5-mini,gemini=gemini-2.5-flash,groq=openai/gpt-oss-20b

AZURE_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1
AZURE_API_KEY=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# Optional: "low" makes gpt-oss and gpt-5 models faster and more reliable.
LLM_REASONING_EFFORT=low

# true = roles saved in backend/demo_cache.json are answered with no AI call.
DEMO_MODE=false

# Browser addresses allowed to call the API (comma-separated, no trailing slash, no spaces).
FRONTEND_ORIGINS=http://localhost:5173
